{
  "name": "fanya-telegram",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/src/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/db/schema.sql', 'dist/src/db/schema.sql')\"",
    "db:clean": "node -e \"const fs=require('node:fs');['data/fanya.db','data/fanya.db-shm','data/fanya.db-wal'].forEach(f=>fs.rmSync(f,{force:true}));console.log('db cleaned')\"",
    "test": "tsx --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "grammy": "^1.40.1",
    "openai": "^6.32.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
